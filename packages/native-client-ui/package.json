{
  "name": "@cloud-machine/native-client-ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Desktop/Android 共用的本地客户端业务界面",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./host": "./src/host.tsx",
    "./styles.css": "./src/styles.css",
    "./components/workbench-runtime-context": "./src/components/workbench-runtime-context.ts",
    "./components/*": "./src/components/*.tsx",
    "./lib/*": "./src/lib/*.ts",
    "./stores/*": "./src/stores/*.ts",
    "./views/*": "./src/views/*.tsx"
  },
  "scripts": {
    "ghostty:wasm": "bun run scripts/prepare-ghostty-wasm.ts",
    "pdfjs:assets": "bun run scripts/prepare-pdfjs-assets.ts",
    "fonts:assets": "bun run scripts/prepare-geist-fonts.ts && bun run ../workspace-ui/scripts/copy-terminal-fonts.ts --target public/fonts",
    "prepare:assets": "bun run ghostty:wasm && bun run pdfjs:assets && bun run fonts:assets",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@cloud-machine/api-client": "workspace:*",
    "@cloud-machine/platform-api": "workspace:*",
    "@cloud-machine/client-contracts": "workspace:*",
    "@cloud-machine/workspace-ui": "workspace:*",
    "@tanstack/react-query": "^5.101.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "css-tree": "^3.2.1",
    "geist": "1.7.2",
    "ghostty-web": "0.4.0",
    "lucide-react": "^1.34.0",
    "monaco-editor": "^0.56.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.4",
    "@types/bun": "1.4.2",
    "@types/css-tree": "^3.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0"
  }
}
