{
  "name": "@cloud-machine/desktop",
  "version": "0.2.32",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "bun run --cwd ../../packages/native-client-ui prepare:assets",
    "dev": "bun run prepare:assets && vite --port 1420",
    "build": "bun run prepare:assets && tsc -p tsconfig.json --noEmit && vite build",
    "connector:prepare": "bun run scripts/prepare-native-connector.ts",
    "bundle": "bun run connector:prepare && tauri build --config src-tauri/tauri.connector.conf.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "bun test",
    "test:preview-layout": "bun scripts/test-preview-layout.ts",
    "test:file-preview": "bun scripts/test-file-preview.ts",
    "test:preview-theme": "bun scripts/test-preview-theme.ts",
    "test:theme-menu": "bun scripts/test-theme-menu.ts",
    "test:file-search": "bun scripts/test-file-search.ts",
    "release:build": "bun run scripts/build-windows-release.ts",
    "release:prepare": "bun run scripts/prepare-windows-release.ts",
    "release:prepare-all": "bun run scripts/prepare-desktop-release.ts",
    "tauri": "tauri"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@cloud-machine/api-client": "workspace:*",
    "@cloud-machine/client-core": "workspace:*",
    "@cloud-machine/native-client-ui": "workspace:*",
    "@cloud-machine/platform-api": "workspace:*",
    "@cloud-machine/client-contracts": "workspace:*",
    "@cloud-machine/workspace-ui": "workspace:*",
    "@tauri-apps/api": "^2.12.5",
    "@tanstack/react-query": "^5.101.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "css-tree": "^3.2.1",
    "ghostty-web": "0.4.0",
    "geist": "1.7.2",
    "lucide-react": "^1.34.0",
    "monaco-editor": "^0.56.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^6.3.289",
    "qrcode": "^1.5.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.12.3",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.3.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.6",
    "@types/css-tree": "^3.2.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "tailwindcss": "^4.3.3",
    "vite": "^7.3.8"
  }
}
